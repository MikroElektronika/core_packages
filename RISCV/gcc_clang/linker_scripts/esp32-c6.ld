/*
 * @file  esp32-c6.ld
 * @brief Linker script for Espressif ESP32-C6: the whole program runs from internal SRAM.
 *        Generated by scripts/espressif_mcus.py - do not edit, change the generator instead.
 *
 * The ROM bootloader loads the image (esptool elf2image) from flash offset 0x0 into SRAM.
 * SRAM above 0x4087C610 stays reserved for the ROM (its data, stack and the functions this core calls).
 * Usable SRAM: 497 KB.
 */

OUTPUT_ARCH(riscv)
ENTRY(_start)

__stack_size = DEFINED(__stack_size) ? __stack_size : 0x2000;

MEMORY
{
  sram (rwx) : ORIGIN = 0x40800000, LENGTH = 0x7C610
}

SECTIONS
{
  .text :
  {
    _iram_start = .;
    KEEP(*(.text.entry))
    KEEP(*(.text.vectors))
    KEEP(*(.text.trap))
    *(.iram1 .iram1.* .iram0.text .iram0.text.*)
    *(.text .text.* .gnu.linkonce.t.*)
    . = ALIGN(4);
    _iram_end = .;
  } > sram

  .rodata :
  {
    . = ALIGN(4);
    KEEP(*(.rodata.esp_irq_handlers))
    *(.rodata .rodata.* .gnu.linkonce.r.*)
    *(.srodata .srodata.*)
    . = ALIGN(4);
  } > sram

  .init_array :
  {
    PROVIDE_HIDDEN(__preinit_array_start = .);
    KEEP(*(.preinit_array))
    PROVIDE_HIDDEN(__preinit_array_end = .);
    PROVIDE_HIDDEN(__init_array_start = .);
    KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*) SORT_BY_INIT_PRIORITY(.ctors.*)))
    KEEP(*(.init_array .ctors))
    PROVIDE_HIDDEN(__init_array_end = .);
    PROVIDE_HIDDEN(__fini_array_start = .);
    KEEP(*(SORT_BY_INIT_PRIORITY(.fini_array.*) SORT_BY_INIT_PRIORITY(.dtors.*)))
    KEEP(*(.fini_array .dtors))
    PROVIDE_HIDDEN(__fini_array_end = .);
  } > sram

  .data :
  {
    . = ALIGN(4);
    _data = .;
    *(.data .data.* .gnu.linkonce.d.*)
    *(.dram1 .dram1.*)
    . = ALIGN(8);
    PROVIDE(__global_pointer$ = . + 0x800);
    *(.sdata .sdata.* .gnu.linkonce.s.*)
    . = ALIGN(4);
    _edata = .;
  } > sram

  /* Thread local storage (picolibc errno): one block, tp points at its start (RISC-V TLS variant I) */
  .tdata :
  {
    . = ALIGN(8);
    __tls_base = .;
    *(.tdata .tdata.* .gnu.linkonce.td.*)
  } > sram

  .tbss (NOLOAD) :
  {
    __bss_start = .;
    *(.tbss .tbss.* .gnu.linkonce.tb.*)
    *(.tcommon)
    . = ALIGN(4);
  } > sram

  .bss (NOLOAD) :
  {
    . = ALIGN(4);
    *(.sbss .sbss.* .gnu.linkonce.sb.*)
    *(.bss .bss.* .gnu.linkonce.b.*)
    *(COMMON)
    . = ALIGN(4);
    __bss_end = .;
  } > sram

  . = ALIGN(16);
  PROVIDE(end = .);
  PROVIDE(_end = .);
  PROVIDE(__heap_start = .);
  __stack_top = ORIGIN(sram) + LENGTH(sram);
  PROVIDE(__heap_end = __stack_top - __stack_size);
  ASSERT(__bss_end <= __stack_top - __stack_size, "ESP32-C6: program and stack do not fit into SRAM")
}

