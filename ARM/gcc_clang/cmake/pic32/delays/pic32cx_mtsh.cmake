if(${MCU_NAME} MATCHES "^PIC32CX1025MTSH128$|^PIC32CX2051MTSH128$|^PIC32CX5112MTSH128$")
    if("${CORE_DIR}" MATCHES "^core_1_")
        # Core 1 runs at its own clock (CPU_CLK1 = MCK1), while FOSC_KHZ_VALUE (the definition
        # "clock") is the core 0 clock. Its frequency follows from the definition registers that
        # core 0 programs (init_clock.c): MAINCK is the 12 MHz main RC, or the crystal frequency
        # recovered from the core 0 clock chain (12 MHz assumed when core 0 does not use it).
        list(APPEND local_list_macros
            "PIC32CX_MT_TD_SLCK_HZ ((VALUE_SUPC_CR & 0x00000008UL) ? 32768ULL : 32000ULL)"
            "PIC32CX_MT_PLL_MUL(ctrl1) ((unsigned long long)((ctrl1) & 0xFFFFUL) + 1ULL)"
            "PIC32CX_MT_PLL_DIV0(ctrl0) ((unsigned long long)((ctrl0) & 0xFFUL) + 1ULL)"
            "PIC32CX_MT_PLL_DIV1(ctrl0) ((unsigned long long)(((ctrl0) >> 12) & 0xFFUL) + 1ULL)"
            "PIC32CX_MT_PLL_FROM_MAINCK(ctrl0) (0UL != ((ctrl0) & 0x08000000UL))"
            "PIC32CX_MT_CSS0 (VALUE_PMC_CPU_CKR & 0x3UL)"
            "PIC32CX_MT_PRES0 ((7UL == ((VALUE_PMC_CPU_CKR >> 4) & 0x7UL)) ? 3ULL : (1ULL << ((VALUE_PMC_CPU_CKR >> 4) & 0x7UL)))"
            "PIC32CX_MT_MCK0_SOURCE_HZ (FOSC_KHZ_VALUE * 1000ULL * PIC32CX_MT_PRES0)"
            "PIC32CX_MT_MAINCK_HZ ((0UL == (VALUE_CKGR_MOR & 0x01000000UL)) ? 12000000ULL : (1UL == PIC32CX_MT_CSS0) ? PIC32CX_MT_MCK0_SOURCE_HZ : ((3UL == PIC32CX_MT_CSS0) && PIC32CX_MT_PLL_FROM_MAINCK(VALUE_PMC_PLLB_CTRL0)) ? (PIC32CX_MT_MCK0_SOURCE_HZ * PIC32CX_MT_PLL_DIV0(VALUE_PMC_PLLB_CTRL0) / PIC32CX_MT_PLL_MUL(VALUE_PMC_PLLB_CTRL1)) : ((2UL == PIC32CX_MT_CSS0) && PIC32CX_MT_PLL_FROM_MAINCK(VALUE_PMC_PLLA_CTRL0)) ? (PIC32CX_MT_MCK0_SOURCE_HZ * PIC32CX_MT_PLL_DIV1(VALUE_PMC_PLLA_CTRL0) / PIC32CX_MT_PLL_MUL(VALUE_PMC_PLLA_CTRL1)) : ((3UL == PIC32CX_MT_CSS0) && PIC32CX_MT_PLL_FROM_MAINCK(VALUE_PMC_PLLA_CTRL0)) ? (PIC32CX_MT_MCK0_SOURCE_HZ * PIC32CX_MT_PLL_DIV0(VALUE_PMC_PLLB_CTRL0) / PIC32CX_MT_PLL_MUL(VALUE_PMC_PLLB_CTRL1) * PIC32CX_MT_PLL_DIV0(VALUE_PMC_PLLA_CTRL0) / PIC32CX_MT_PLL_MUL(VALUE_PMC_PLLA_CTRL1)) : 12000000ULL)"
            "PIC32CX_MT_PLLA_REF_HZ (PIC32CX_MT_PLL_FROM_MAINCK(VALUE_PMC_PLLA_CTRL0) ? PIC32CX_MT_MAINCK_HZ : PIC32CX_MT_TD_SLCK_HZ)"
            "PIC32CX_MT_PLLACK0_HZ (PIC32CX_MT_PLLA_REF_HZ * PIC32CX_MT_PLL_MUL(VALUE_PMC_PLLA_CTRL1) / PIC32CX_MT_PLL_DIV0(VALUE_PMC_PLLA_CTRL0))"
            "PIC32CX_MT_PLLACK1_HZ (PIC32CX_MT_PLLA_REF_HZ * PIC32CX_MT_PLL_MUL(VALUE_PMC_PLLA_CTRL1) / PIC32CX_MT_PLL_DIV1(VALUE_PMC_PLLA_CTRL0))"
            "PIC32CX_MT_PLLBCK_HZ ((PIC32CX_MT_PLL_FROM_MAINCK(VALUE_PMC_PLLB_CTRL0) ? PIC32CX_MT_MAINCK_HZ : PIC32CX_MT_PLLACK0_HZ) * PIC32CX_MT_PLL_MUL(VALUE_PMC_PLLB_CTRL1) / PIC32CX_MT_PLL_DIV0(VALUE_PMC_PLLB_CTRL0))"
            "PIC32CX_MT_PLLCCK_HZ ((PIC32CX_MT_PLL_FROM_MAINCK(VALUE_PMC_PLLC_CTRL0) ? PIC32CX_MT_MAINCK_HZ : PIC32CX_MT_PLLACK0_HZ) * PIC32CX_MT_PLL_MUL(VALUE_PMC_PLLC_CTRL1) / PIC32CX_MT_PLL_DIV0(VALUE_PMC_PLLC_CTRL0))"
            "PIC32CX_MT_CPCSS ((VALUE_PMC_CPU_CKR >> 16) & 0x7UL)"
            "PIC32CX_MT_CORE1_SOURCE_HZ ((5UL == PIC32CX_MT_CPCSS) ? PIC32CX_MT_PLLCCK_HZ : (4UL == PIC32CX_MT_CPCSS) ? PIC32CX_MT_PLLBCK_HZ : (3UL == PIC32CX_MT_CPCSS) ? PIC32CX_MT_PLLACK1_HZ : (2UL == PIC32CX_MT_CPCSS) ? (FOSC_KHZ_VALUE * 1000ULL) : (1UL == PIC32CX_MT_CPCSS) ? PIC32CX_MT_MAINCK_HZ : 32000ULL)"
            "PIC32CX_MT_CORE1_KHZ ((unsigned long)(PIC32CX_MT_CORE1_SOURCE_HZ / ((unsigned long long)((VALUE_PMC_CPU_CKR >> 20) & 0xFUL) + 1ULL) / 1000ULL))"
            "getClockValue(_clock) (((FOSC_KHZ_VALUE == (_clock)) ? PIC32CX_MT_CORE1_KHZ : (_clock))/1000UL/6)")
    else()
        list(APPEND local_list_macros "getClockValue(_clock) (_clock/1000UL/6)")
    endif()
endif()
